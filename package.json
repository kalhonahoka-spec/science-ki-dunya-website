{
  "name": "science-ki-dunya-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "db:push": "prisma generate && prisma db push",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.tsx"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^6.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vitejs/plugin-react": "latest",
    "framer-motion": "12.38.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.186.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@testing-library/react": "^16.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.1.3",
    "prisma": "^6.4.1",
    "tsx": "^4.23.15",
    "typescript": "latest"
  }
}
